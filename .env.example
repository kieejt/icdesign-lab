# Credentials for the MongoDB container, read by docker-compose.yml.
#
# Kept here rather than in server/.env so the database container does not also
# receive JWT_SECRET and GROQ_API_KEY in its environment — if Mongo is ever
# compromised, those should not be sitting next to it.
#
# Copy to `.env` (gitignored) and set a strong password:
#   openssl rand -base64 32

MONGO_ROOT_USER=icdesign
MONGO_ROOT_PASSWORD=change_me

# server/.env must then point MONGO_URI at the same credentials, e.g.
#   MONGO_URI=mongodb://icdesign:<password>@mongodb:27017/icdesign_lab?authSource=admin

# Production only: start the Cloudflare Tunnel (the `cloudflared` service).
# The token comes from Cloudflare Zero Trust > Networks > Tunnels > the tunnel >
# Configure (the long string after `--token`). It lets anyone holding it serve
# traffic for the site's hostnames, so treat it like a password.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
