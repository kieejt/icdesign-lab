PORT=5000

# Public origin of the site (no trailing slash). Used for the sitemap, robots.txt
# and link-preview tags. Falls back to the request Host header when unset.
# SITE_URL=https://icdesign.example.com

# Inside Docker the database is reached by service name over the compose network
# — it is no longer published to the host. The credentials must match
# MONGO_ROOT_USER / MONGO_ROOT_PASSWORD in the repository-root .env.
#
#   docker:  mongodb://icdesign:<password>@mongodb:27017/icdesign_lab?authSource=admin
#   local:   mongodb://127.0.0.1:27017/icdesign_lab
MONGO_URI=mongodb://127.0.0.1:27017/icdesign_lab

JWT_SECRET=your_super_secret_key_here

# First-admin setup over HTTP. Unset (the default) means POST /api/auth/register is
# disabled; create the admin with `npm run create-admin` instead. Set it only for
# the minutes you need it, send it as `setupToken` in the request body, then remove it.
# ADMIN_SETUP_TOKEN=

# Browser origins allowed to call this API with credentials, comma separated.
#
# Leave empty when the frontend is served from the same origin (the nginx setup
# in docker-compose does this). An empty value now REFUSES all cross-origin
# browser requests — it no longer means "allow everything".
CORS_ORIGINS=http://localhost:5173

# The assistant is switched off. It was an experiment and every message is a
# paid AI call on an endpoint that must stay unauthenticated. Set both this and
# the client's VITE_CHATBOT_ENABLED to "true" to bring it back.
CHATBOT_ENABLED=false
GROQ_API_KEY=your_groq_api_key_here

# Model used to summarise and judge news (and by the chat assistant). Groq retires
# models without much notice; the previous default answered 404 and the agent
# silently fell back to raw snippets. List what your key can use with
# GET https://api.groq.com/openai/v1/models, then set it here.
# GROQ_MODEL=openai/gpt-oss-20b

# Run a news fetch shortly after boot if the last successful one is over 26 h old
# (e.g. the server was down at the scheduled minute). On by default in production,
# off elsewhere; set true/false to override.
# NEWS_CATCH_UP=true

# How long a sign-in lasts. Governs both the JWT expiry and the cookie lifetime.
SESSION_TTL_HOURS=24

# Chat messages allowed per IP per 10 minutes. Every message is a paid AI call,
# so this is a spending limit as much as an abuse limit.
CHAT_RATE_LIMIT=15
