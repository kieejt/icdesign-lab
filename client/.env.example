# Base URL for the API.
#
# Leave this unset in development: vite.config.js proxies /api and /uploads to
# http://localhost:5000, which keeps the dev setup same-origin exactly like
# production behind nginx.
#
# Set it only when the API lives on a different host from the frontend.
# VITE_API_URL=https://api.example.com/api

# The chat assistant is switched off; the server gates it with CHATBOT_ENABLED.
# Both must be "true" for the widget to appear.
VITE_CHATBOT_ENABLED=false
